{
    "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": [
            "**/*.ts",
            "**/*.tsx",
            "**/*.js",
            "**/*.jsx",
            "**/*.json",
            "!**/node_modules",
            "!**/.next",
            "!**/.claude",
            "!**/migrations",
            "!**/dist",
            "!**/build",
            "!**/out",
            "!**/coverage",
            "!**/public",
            "!**/.drizzle",
            "!**/*.config.js",
            "!**/*.config.ts",
            "!**/*.config.mjs",
            "!**/drizzle.config.ts",
            "!**/biome.json"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 80,
        "lineEnding": "lf",
        "formatWithErrors": false,
        "bracketSpacing": true
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "jsxQuoteStyle": "double",
            "semicolons": "always",
            "trailingCommas": "all",
            "arrowParentheses": "always",
            "bracketSpacing": true,
            "bracketSameLine": false,
            "attributePosition": "multiline"
        }
    },
    "json": {
        "formatter": {
            "indentWidth": 4
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": {
                    "level": "on",
                    "options": {
                        "groups": [
                            "builtin",
                            ["react", "react-*"],
                            "external",
                            "blankLine",
                            ["@/app/**"],
                            ["@/application/**"],
                            ["@/domain/**"],
                            ["@/infrastructure/**"],
                            ["@/shared/**"],
                            ["@/**"],
                            "blankLine",
                            "relative"
                        ]
                    }
                }
            }
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "suspicious": {
                "noExplicitAny": "off",
                "noDocumentCookie": "off",
                "noConsole": {
                    "level": "warn",
                    "options": {
                        "allow": ["warn", "error"]
                    }
                },
                "noArrayIndexKey": "off"
            },
            "correctness": {
                "noUnusedImports": "error",
                "noUnusedVariables": {
                    "level": "warn",
                    "fix": "none"
                },
                "useExhaustiveDependencies": "off"
            },
            "style": {
                "noNonNullAssertion": "off",
                "useImportType": "warn",
                "useExportType": "warn",
                "useNodejsImportProtocol": "warn"
            },
            "a11y": {
                "preset": "recommended",
                "useSemanticElements": "off"
            },
            "complexity": {
                "noBannedTypes": "warn",
                "noUselessCatch": "warn"
            },
            "performance": {
                "noAccumulatingSpread": "warn"
            }
        }
    },
    "overrides": [
        {
            "includes": ["**/*.tsx"],
            "javascript": {
                "formatter": {
                    "lineWidth": 100,
                    "jsxQuoteStyle": "double"
                }
            },
            "linter": {
                "rules": {
                    "style": {
                        "useFilenamingConvention": "off"
                    }
                }
            }
        },
        {
            "includes": ["src/shared/components/ui/**"],
            "linter": {
                "rules": {
                    "a11y": {
                        "useKeyWithClickEvents": "off",
                        "useSemanticElements": "off"
                    }
                }
            }
        }
    ]
}
