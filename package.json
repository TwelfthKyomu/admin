{
    "name": "admin",
    "version": "0.1.0",
    "private": true,
    "sideEffects": [
        "**/*.css"
    ],
    "overrides": {
        "react": "19.3.0",
        "react-dom": "19.3.0"
    },
    "scripts": {
        "dev": "next dev --turbopack",
        "build": "next build",
        "analyze": "next experimental-analyze",
        "start": "next start",
        "typecheck": "tsc --noEmit",
        "lint": "biome check --write . && eslint --fix",
        "lint:ci": "biome ci . && eslint",
        "lint:check": "biome check . && eslint",
        "format": "biome format --write .",
        "docker:up": "docker compose up -d --wait",
        "docker:down": "docker compose down",
        "docker:logs": "docker compose logs -f postgres",
        "docker:ps": "docker compose ps",
        "db:push": "bunx drizzle-kit push",
        "db:generate": "bunx drizzle-kit generate",
        "db:migrate": "tsx src/infrastructure/database/migrate.ts",
        "db:studio": "bunx drizzle-kit studio",
        "test": "vitest run --passWithNoTests",
        "test:watch": "vitest --passWithNoTests",
        "deadcode": "knip --no-progress",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1149.0",
        "@aws-sdk/s3-request-presigner": "^3.1149.0",
        "@hookform/resolvers": "^5.9.1",
        "@react-email/components": "^1.0.12",
        "@react-email/render": "^2.1.0",
        "@shadcn/react": "^0.3.1",
        "@t3-oss/env-nextjs": "^0.13.11",
        "@tanstack/react-query": "^5.102.8",
        "@tanstack/react-table": "^8.21.3",
        "better-auth": "^1.7.7",
        "better-auth-localization": "^4.0.0",
        "bowser": "^2.14.1",
        "class-variance-authority": "^0.7.1",
        "cmdk": "^1.1.1",
        "cnfast": "^0.1.0",
        "date-fns": "^4.4.0",
        "drizzle-orm": "^0.45.2",
        "file-type": "^22.1.1",
        "input-otp": "^1.5.0",
        "lucide-react": "^0.577.0",
        "next": "^16.4.0",
        "next-intl": "^4.14.1",
        "next-safe-action": "^8.6.1",
        "next-themes": "^0.4.6",
        "nuqs": "^2.10.1",
        "pg": "^8.23.0",
        "radix-ui": "^1.6.7",
        "react": "19.3.0",
        "react-day-picker": "^10.0.1",
        "react-dom": "19.3.0",
        "react-hook-form": "^7.86.0",
        "resend": "^6.25.0",
        "server-only": "^0.0.1",
        "slugify": "^1.6.6",
        "sonner": "^2.0.8",
        "stripe": "^22.6.2",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.5.1"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.11",
        "@electric-sql/pglite": "^0.5.8",
        "@next/env": "^16.4.0",
        "@storybook/addon-docs": "^10.5.10",
        "@storybook/nextjs-vite": "^10.5.10",
        "@storybook/react": "^10.5.10",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/node": "25.9.5",
        "@types/pg": "^8.23.1",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "drizzle-kit": "^0.31.10",
        "eslint": "^9.39.5",
        "knip": "^6.33.0",
        "postcss": "^8.5.26",
        "storybook": "^10.5.10",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.12",
        "typescript": "5.9.3",
        "typescript-eslint": "^8.71.1",
        "vitest": "^4.1.11"
    },
    "devEngines": {
        "packageManager": {
            "name": "nub",
            "version": "^0.4.13",
            "onFail": "warn"
        }
    }
}
